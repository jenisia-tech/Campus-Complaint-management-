# Campus Complaint Management System - Supabase & Next.js Configuration

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Optional Service Role Secret (ONLY for server-side maintenance/admin scripts, NEVER expose via NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# Application Base URL (Used for Auth Redirects & Email Callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
